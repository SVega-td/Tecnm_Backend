@model List<HelpDeskWeb.Models.TicketPriority>

<h1>Ticket Priority</h1>

<div class="row">
    <div class="col-12">
        <a asp-controller="PriorityTicket" asp-action="Create" class="btn btn-primary">
            Crear Nueva Prioridad
        </a>
        <table class="table">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Created AT</th>
                    <th>Updateted AT</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var priority in Model)
                {
                    <tr>
                        <td>@priority.Name</td>
                        <td>@priority.CreatedAT</td>
                        <td>@priority.UpdatedAT</td>
                        <td>
                            <a asp-controller="PriorityTicket" asp-action="Edit" asp-route-id="@priority.Id" class="btn btn-primary">Editar</a>
                            <form asp-controller="PriorityTicket" asp-action="Delete" method="post" class="d-inline" onsubmit="return confirm('¿Seguro que deseas eliminar este registro?');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@priority.Id" />
                                <button type="submit" class="btn btn-danger">
                                    Delete
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>