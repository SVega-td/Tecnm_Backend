@model List<HelpDeskWeb.Models.TicketStatus>

<h1>Ticket Status</h1>

<div class="row">
    <div class="col-12">
        @* Botón para crear un nuevo registro *@
        <a asp-controller="TicketStatus" asp-action="Create" class="btn btn-primary mb-3">Crear Nuevo Ticket Status</a>

        <table class="table">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Created At</th>
                    <th>Updated At</th>
                    <th></th> @* Columna vacía para los botones de acción *@
                </tr>
            </thead>
            <tbody>
                @foreach (var status in Model)
                {
                    <tr>
                        <td>@status.Name</td>
                        <td>@status.CreatedAt</td>
                        <td>@status.UpdatedAt</td>
                        <td>
                            @* Botón de Editar dentro del td[cite: 1, 3, 4] *@
                            <a asp-controller="TicketStatus" asp-action="Edit" asp-route-id="@status.Id" class="btn btn-primary">Editar</a>
                            
                            @* Formulario de Eliminar correctamente encapsulado[cite: 1, 3, 4] *@
                            <form asp-controller="TicketStatus" asp-action="Delete" method="post" class="d-inline" onsubmit="return confirm('¿Seguro que deseas eliminar este registro?');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@status.Id" />
                                <button type="submit" class="btn btn-danger">Eliminar</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>